{
  "name": "network-arbitrary",
  "image": "mcr.microsoft.com/devcontainers/base:3.0.14-ubuntu26.04@sha256:e15941f70f26542ef9b0ef4bb64f88b8ecdfe8c3372e730ab6e405792805e742",
  "features": {
    "ghcr.io/devcontainers-extra/features/mise:1": {}
  },
  "containerEnv": {
    "MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
  },
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.ghcup/bin:/home/vscode/.local/share/mise/shims:${containerEnv:PATH}"
  },
  "postCreateCommand": ".devcontainer/post-create.sh"
}
