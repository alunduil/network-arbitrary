root = true

# trim_trailing_whitespace and insert_final_newline mirror the
# trailing-whitespace and end-of-file-fixer pre-commit hooks. Change
# them together, or the hooks undo the editor's output on commit.
[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true
indent_style = space
indent_size = 2
